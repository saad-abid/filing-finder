# Copy this file to .env and fill in real values. Never commit .env.

# SEC asks for a contact in the User-Agent: "Your Name your.email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# Local Postgres (Docker Compose)
POSTGRES_USER=filingfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filingfinder
# Use 127.0.0.1, not localhost: on Windows "localhost" tries IPv6 first and hangs.
DATABASE_URL=postgresql://filingfinder:change-me@127.0.0.1:5432/filingfinder

# Local AI model (Ollama, free, no account). Download with: ollama pull qwen3.5:4b
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
