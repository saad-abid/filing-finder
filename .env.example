# Copy this file to .env and fill in real values. Never commit .env.

# SEC asks for a contact in the User-Agent: "Your Name your.email@example.com"
SEC_USER_AGENT=Your Name your.email@example.com

# Local Postgres (Docker Compose)
POSTGRES_USER=filingfinder
POSTGRES_PASSWORD=change-me
POSTGRES_DB=filingfinder
DATABASE_URL=postgresql://filingfinder:change-me@localhost:5432/filingfinder
